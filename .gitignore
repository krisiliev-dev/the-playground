# ── Dependencies ────────────────────────────────────────────────────
node_modules/
# Worktree-deps symlink — `client/node_modules` is a symlink to a
# shared deps store, not a directory, so the trailing-slash pattern
# above doesn't catch it. Add the explicit path.
client/node_modules

# ── Build output ────────────────────────────────────────────────────
client/dist/
client/storybook-static/
server/target/
# Runtime-written scene snapshot (per ADR-004). Operator-authored
# state, not source — the default path is `state.json` next to the
# server binary. Production deploys can point STATE_FILE elsewhere.
server/state.json
server/state.json.tmp
server/state.json.probe
# Runtime-uploaded admin assets (per ADR-007). Operator-authored
# content, not source. Default path is `assets/` next to the
# server binary; production deploys point ASSETS_DIR elsewhere.
server/assets/

# ── IDE / Editor ────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Environment variables (never commit secrets) ───────────────────
.env
.env.local
.env.production
.env.*.local

# ── Test & Coverage ─────────────────────────────────────────────────
coverage/
*.lcov

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Rust ────────────────────────────────────────────────────────────
**/*.rs.bk
*.rlib

# ── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── Vercel ──────────────────────────────────────────────────────────
.vercel

# ── Media (large binaries, served via the admin pipeline) ──────────
client/public/videos/*.mp4
client/public/videos/*.webm
client/public/videos/*.jpg
client/public/videos/*.png
client/src/assets/*.mp4
client/src/assets/*.webm
